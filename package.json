{
  "name": "tiles-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && npm run build:leaderboard-contract",
    "build:leaderboard-contract": "vite build --config vite.server-contract.config.ts && tsc -p tsconfig.contract.json && node scripts/finalize-leaderboard-contract.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:ci-workflow": "node --test tests/scripts/ciWorkflow.test.mjs",
    "test:publish-safety": "node --test tests/scripts/publishRoadcrosserSafety.test.mjs",
    "test:account-contracts": "node --test tests/account/scorePublicationContractSafety.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:leaderboard-contract": "playwright test --config playwright.contract.config.ts",
    "publish:roadcrosser": "node scripts/publish-roadcrosser.mjs --force"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.8"
  }
}
